{
  "service": "AILeash Governance API",
  "version": "1.0.0",
  "status": "active",
  "description": "AI governance, trust scoring, audit logging, and policy enforcement service.",
  "endpoints": {
    "POST /govern": {
      "description": "Score and evaluate an AI action event",
      "response": {
        "risk_score": "float",
        "trust_score": "float",
        "decision": "allow | warn | block",
        "audit_id": "string"
      }
    },
    "GET /health": {
      "description": "Liveness and readiness check",
      "response": {
        "status": "ok"
      }
    },
    "GET /audit": {
      "description": "Return last 50 audit records"
    },
    "GET /user/<id>": {
      "description": "Return user trust state and governance history"
    }
  }
}
