<script>
function doSignup() {
  var email = document.getElementById("email").value.trim();
  var ok = document.getElementById("msg-ok");
  var err = document.getElementById("msg-err");
  var btn = document.getElementById("pay-btn");

  ok.style.display = "none";
  err.style.display = "none";

  if (!email || email.indexOf("@") < 0) {
    err.textContent = "Please enter a valid email address.";
    err.style.display = "block";
    return;
  }

  btn.textContent = "Setting up...";
  btn.disabled = true;

  fetch("/register", {
    method: "POST",
    headers: {"Content-Type": "application/json"},
    body: JSON.stringify({email: email})
  })
  .then(function(r) { return r.json(); })
  .then(function(data) {
    if (data.api_key) {
      window.location.href = "/checkout?key=" + data.api_key + "&email=" + encodeURIComponent(email);
    } else {
      err.textContent = data.error || "Something went wrong. Email hello@monopcontent.com";
      err.style.display = "block";
      btn.textContent = "Start for $99/month";
      btn.disabled = false;
    }
  })
  .catch(function(e) {
    err.textContent = "Connection error: " + e.message + ". Please try again.";
    err.style.display = "block";
    btn.textContent = "Start for $99/month";
    btn.disabled = false;
  });
}
</script>

